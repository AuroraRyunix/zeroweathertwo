<div class="min-h-screen pb-16">
  <header>
    <div class="zw-wrap h-14 flex items-center justify-between">
      <span class="font-semibold">ZeroWeather</span>
      <div class="flex items-center gap-2">
        <%= if @active_location.id != "ghent" do %>
          <button id="home-btn" phx-click="select_location" phx-value-id="ghent" class="zw-btn">
            Ghent
          </button>
        <% end %>
        <button id="geo-btn" phx-hook="Geolocation" class="zw-btn">Use my location</button>
        <button id="theme-btn" type="button" onclick="zwToggleTheme()" class="zw-btn">
          Light / dark
        </button>
      </div>
    </div>
  </header>

  <main class="zw-wrap">
    <%= if @error_message do %>
      <p class="py-3 text-sm" style="color: var(--zw-chance)">{@error_message}</p>
    <% end %>

    <%= if @weather do %>
      <section class="py-6">
        <h1 class="text-3xl font-semibold">{@active_location.name}</h1>
        <p class="zw-muted text-sm mt-0.5">
          {@active_location.lat}° N, {@active_location.lon}° E
        </p>

        <div class="mt-4 flex flex-wrap items-baseline gap-x-8 gap-y-1">
          <span class="text-5xl font-semibold">{@weather.current.temperature}°C</span>
          <span class="zw-muted">{@weather.current.condition_text}</span>
        </div>

        <dl class="zw-dl mt-6">
          <dt>Wind</dt>
          <dd>{@weather.current.wind_speed} km/h from {@weather.current.wind_direction}°</dd>
          <dt>Humidity</dt>
          <dd>{@weather.current.humidity}%</dd>
          <dt>Pressure</dt>
          <dd>{@weather.current.pressure} hPa</dd>
          <dt>Precipitation now</dt>
          <dd>{@weather.current.precipitation} mm</dd>
          <%= if @weather.air_quality do %>
            <dt>Air quality (EAQI)</dt>
            <dd>
              {@weather.air_quality.eaqi || "--"}, {@weather.air_quality.label}
              <span class="zw-muted">
                · PM2.5 {@weather.air_quality.pm2_5 || "--"} · PM10 {@weather.air_quality.pm10 ||
                  "--"} · NO₂ {@weather.air_quality.no2 || "--"} µg/m³
              </span>
            </dd>
          <% end %>
          <dt>Elevation</dt>
          <dd>{@weather.elevation} m</dd>
        </dl>
      </section>

      <%= if @radar_nowcast do %>
        <% chart = rain_chart(@radar_nowcast.series) %>
        <section id="radar-nowcast-card" class="zw-section">
          <h2 class="zw-h">Rain countdown, next 2 hours</h2>

          <p id="radar-nowcast-headline" class="text-xl font-semibold">
            {@radar_nowcast.summary.headline}
          </p>
          <%= if @radar_nowcast.summary.detail do %>
            <p id="radar-nowcast-detail" class="mt-1">{@radar_nowcast.summary.detail}</p>
          <% end %>
          <%= if @own_loading and not own?(@radar_nowcast) do %>
            <p id="radar-nowcast-loading" class="mt-2 text-sm zw-muted">
              Computing our own radar nowcast; showing Buienradar's forecast meanwhile.
            </p>
          <% end %>

          <svg
            id="radar-nowcast-strip"
            viewBox={"0 0 #{chart.w} #{chart.h}"}
            role="img"
            aria-label="Expected rain rate per minute and chance of rain for the next two hours"
            class="zw-chart w-full mt-5"
          >
            <%= for t <- chart.y_ticks do %>
              <line class="grid" x1={chart.left} x2={chart.right} y1={t.y} y2={t.y} />
              <text x={chart.left - 6} y={t.y + 3} text-anchor="end">{t.label}</text>
            <% end %>
            <%= if chart.has_chance do %>
              <line
                class="guide"
                x1={chart.left}
                x2={chart.right}
                y1={chart.guide_y}
                y2={chart.guide_y}
              />
              <%= for t <- chart.chance_ticks do %>
                <text x={chart.right + 6} y={t.y + 3}>{t.label}</text>
              <% end %>
            <% end %>
            <%= for bar <- chart.bars do %>
              <rect class="bar" x={bar.x} y={bar.y} width={bar.w} height={bar.h}>
                <title>{bar.title}</title>
              </rect>
            <% end %>
            <%= if chart.line do %>
              <polyline class="line" points={chart.line} />
            <% end %>
            <line class="now" x1={chart.left} x2={chart.left} y1={chart.top} y2={chart.bottom} />
            <%= for t <- chart.x_ticks do %>
              <text x={t.x} y={chart.bottom + 14} text-anchor="middle">{t.label}</text>
            <% end %>
            <text x={chart.left} y={chart.top - 14} text-anchor="start">mm/h</text>
            <%= if chart.has_chance do %>
              <text x={chart.right} y={chart.top - 14} text-anchor="end">chance of rain</text>
            <% end %>
          </svg>
          <p class="mt-2 text-xs zw-muted">
            <span class="zw-key" style="background: var(--zw-rain)"></span>expected rain rate
            <%= if chart.has_chance do %>
              <span class="zw-key ml-4" style="background: var(--zw-chance)"></span>chance of rain
              (dashed: 50%, called "likely" above it)
            <% end %>
          </p>

          <h3 class="zw-h mt-6">Tracking data</h3>
          <%= if own?(@radar_nowcast) do %>
            <dl id="radar-nowcast-tracking" class="zw-dl">
              <dt>Method</dt>
              <dd id="radar-nowcast-source">
                Our own nowcast: radar frames tracked and advected to this point, 1-minute steps
              </dd>
              <dt>Radar source</dt>
              <dd id="radar-nowcast-radar-source">{@radar_nowcast.source}</dd>
              <dt>Rain drift</dt>
              <dd id="radar-nowcast-motion">{motion_text(@radar_nowcast.motion)}</dd>
              <dt>Track confidence</dt>
              <dd>
                {@radar_nowcast.motion.quality} (0 to 1; below 0.45 the rain is assumed to stay put)
              </dd>
              <dt>Radar frame</dt>
              <dd id="radar-nowcast-updated">
                Radar frame {local_clock(@radar_nowcast.frame_time)}, {@radar_nowcast.frame_age_min} min old;
                recomputed every minute
              </dd>
              <%= if @gauge do %>
                <dt>Ground station</dt>
                <dd id="radar-nowcast-gauge">
                  {@gauge.station} ({@gauge.distance_km} km, {local_clock(@gauge.time)}): {@gauge.precip_mm_10min} mm in 10 min, {@gauge.precip_mm_hour} mm in the last hour; {@gauge.temperature}°C, humidity {round(
                    @gauge.humidity || 0
                  )}%,
                  dew point {@gauge.dew_point}°C (depression {@gauge.depression}°C).
                  <%= if virga_risk?(@gauge) do %>
                    Very dry air near the ground: light radar echoes may evaporate before they reach it.
                  <% end %>
                  <span class="zw-muted">Shown for reference; not used to correct the forecast yet.</span>
                </dd>
              <% end %>
              <%= if @buienradar do %>
                <dt>Cross-check</dt>
                <dd id="radar-nowcast-crosscheck">
                  Cross-check, Buienradar's own forecast: {radar_hero_text(@buienradar.summary)}
                </dd>
              <% end %>
            </dl>
          <% else %>
            <dl class="zw-dl">
              <dt>Method</dt>
              <dd id="radar-nowcast-source">
                Buienradar's 5-minute point forecast, interpolated to 1 minute.
                <%= cond do %>
                  <% @own_loading -> %>
                    Shown while our own nowcast is computed.
                  <% @own_error -> %>
                    Our own nowcast is unavailable right now: {@own_error}.
                  <% true -> %>
                    Our own nowcast is unavailable right now.
                <% end %>
              </dd>
              <dt>Fetched</dt>
              <dd id="radar-nowcast-updated">
                {local_clock(@radar_nowcast.fetched_at)}; refreshes every minute
              </dd>
            </dl>
          <% end %>
        </section>
      <% end %>

      <%= if @radar_nowcast && own?(@radar_nowcast) && @radar_nowcast[:diagnostics] do %>
        <% d = @radar_nowcast.diagnostics %>
        <section id="lab" class="zw-section zw-lab">
          <h2 class="zw-h">Maths and metrics</h2>
          <p class="text-sm zw-muted">
            Everything the forecast above is computed from, as it is computed.
            <a
              class="underline"
              href={"/api/v1/nowcast?lat=#{@active_location.lat}&lon=#{@active_location.lon}"}
            >
              Raw JSON
            </a>
          </p>

          <details open id="lab-field">
            <summary>Radar field (window around the point)</summary>
            <dl class="zw-dl mt-2">
              <dt>Window</dt>
              <dd>
                {d.grid.cells} × {d.grid.cells} cells of {d.grid.cell_km} km = {round(
                  d.grid.window_km
                )} km square
              </dd>
              <%= if d.field do %>
                <dt>Rain at the point now</dt>
                <dd>{d.field.rate_at_point_mm_h} mm/h</dd>
                <dt>Wet cells (≥ {d.model.rain_threshold_mm_h} mm/h)</dt>
                <dd>
                  {d.field.wet_cells} of {d.field.total_cells} ({d.field.wet_pct}%), mean {d.field.mean_wet_mm_h} mm/h where wet, maximum {d.field.max_mm_h} mm/h
                </dd>
                <dt>Within 25 km of the point</dt>
                <dd>
                  {d.field.near_25km_wet_pct}% wet, mean {d.field.near_25km_mean_wet_mm_h} mm/h where wet
                </dd>
              <% end %>
            </dl>
          </details>

          <details open id="lab-motion">
            <summary>Motion estimate</summary>
            <dl class="zw-dl mt-2">
              <dt>Shift per {d.motion.frame_step_min} min</dt>
              <dd>
                dx = {d.motion.dx_cells} cells east, dy = {d.motion.dy_cells} cells south
                (cell {d.motion.cell_km} km)
              </dd>
              <dt>Velocity</dt>
              <dd>
                {d.motion.east_km_h} km/h east, {d.motion.south_km_h} km/h south; speed {d.motion.speed_km_h} km/h
              </dd>
              <dt>Correlation</dt>
              <dd>
                {d.motion.quality} (threshold {d.motion.min_quality}; search ±{d.motion.search_range_cells} coarse cells,
                rain within {round(d.motion.tracked_radius_km)} km tracked)
              </dd>
              <%= if d.motion.pairs != [] do %>
                <dt>Frame pairs</dt>
                <dd>
                  <%= for {p, i} <- Enum.with_index(d.motion.pairs) do %>
                    <span class="block">
                      pair {i + 1}: dx {Float.round(p.dx * 1.0, 2)}, dy {Float.round(
                        p.dy * 1.0,
                        2
                      )}, correlation {Float.round(
                        p.quality * 1.0,
                        3
                      )}
                    </span>
                  <% end %>
                  {if d.motion.combined,
                    do: "Pairs agree within 2.5 cells: averaged, weighted by correlation.",
                    else: "Newest pair used alone."}
                </dd>
              <% end %>
              <%= if d[:trend] do %>
                <dt>Wet-area trend</dt>
                <dd>
                  × {d.trend.ratio} ({d.trend.wet_new} wet cells now in the {d.trend.box_km} km box, {d.trend.wet_old} a frame step earlier along the drift). Shown, not applied: on the replay, extrapolating it made
                  every lead band's score worse.
                </dd>
              <% end %>
            </dl>
            <p class="zw-eq">
              score(dx,dy) = Σ f_new(x,y)·f_old(x−dx,y−dy) / √(Σ f_new² · Σ f_old²),  f = ln(1 + mm/h)
              best shift = argmax score, refined by a parabola through its neighbours
            </p>
          </details>

          <details open id="lab-forecast-table">
            <summary>Forecast, every 5 minutes</summary>
            <p class="zw-eq">
              sample point = point − drift × lead  (the rain that arrives is upstream now)
              disk radius = {d.model.smooth_base_km} km + {d.model.smooth_per_min_km} km × lead
              raw % = wet cells in disk / cells in disk;  chance = calibration(raw %, lead)
              rate if rain = mean of the wet cells;  mean = mean of all cells in the disk
            </p>
            <div class="zw-scroll">
              <table class="zw-table" id="lab-series">
                <thead>
                  <tr>
                    <th>Time</th>
                    <th>Lead (min)</th>
                    <th>Upstream (km)</th>
                    <th>Disk (km)</th>
                    <th>Raw</th>
                    <th>Chance</th>
                    <th>Rate if rain (mm/h)</th>
                    <th>Mean (mm/h)</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for p <- lab_rows(@radar_nowcast.series) do %>
                    <tr>
                      <td>{p.time}</td>
                      <td>{p.lead_min}</td>
                      <td>{p.upstream_km}</td>
                      <td>{p.radius_km}</td>
                      <td>{p.chance_raw}%</td>
                      <td>{p.chance}%</td>
                      <td>{p.mm_h}</td>
                      <td>{p.mean_mm_h}</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <dl class="zw-dl mt-2">
              <dt>Expected rain</dt>
              <dd>
                {d.forecast.expected_mm_1h} mm in the next hour, {d.forecast.expected_mm_2h} mm in the next two
                (sum of the mean rate × 1/60 h per minute)
              </dd>
              <dt>Peak</dt>
              <dd>
                {d.forecast.peak_mean_mm_h} mm/h mean at {d.forecast.peak_at}; highest chance {d.forecast.max_chance}%
              </dd>
              <dt>Likely minutes</dt>
              <dd>
                {d.forecast.likely_minutes} of {d.forecast.series_minutes} minutes at ≥ {d.model.likely_pct}% chance
              </dd>
              <dt>Computed in</dt>
              <dd>{d.forecast.compute_ms} ms for this series</dd>
            </dl>
          </details>

          <details id="lab-calibration">
            <summary>Calibration tables (raw % → chance %)</summary>
            <p class="zw-eq">
              Fitted on a replay of radar and checked on a second replay; blended linearly between the leads shown,
              and shrunk by up to {round(d.model.late_shrink * 100)}% towards +120 min.
              "Likely" at ≥ {d.model.likely_pct}%, "possible" at ≥ {d.model.possible_pct}%.
            </p>
            <dl class="zw-dl mt-2">
              <%= for c <- d.model.calibration do %>
                <dt>At +{c.lead_min} min</dt>
                <dd class="font-mono text-xs">
                  {Enum.map_join(c.table, ", ", fn [raw, cal] -> "#{raw}→#{cal}" end)}
                </dd>
              <% end %>
            </dl>
          </details>

          <details open id="lab-gauge">
            <summary>Rain gauge check</summary>
            <%= if d[:gauge] do %>
              <% g = d.gauge %>
              <dl class="zw-dl mt-2">
                <dt>Stations</dt>
                <dd>
                  <%= for st <- g[:stations] || [] do %>
                    <span class="block">
                      {st.station}
                      <%= if st[:distance_km] do %>
                        ({st.distance_km} km)
                      <% end %>: gauge {st.gauge_mm} mm, radar {st.radar_mm} mm over {st.paired} intervals
                    </span>
                  <% end %>
                </dd>
                <dt>Total, last {g.window_min} min</dt>
                <dd>
                  gauge {g.gauge_mm} mm, radar {g.radar_mm} mm over {g.paired} paired 10-minute intervals
                </dd>
                <dt>Correction</dt>
                <dd>
                  <%= cond do %>
                    <% g[:applied] -> %>
                      rate × {g.factor} (ratio {g.ratio}, weight {g.weight}); {g.note}
                    <% true -> %>
                      none (factor 1.0): {g[:note] || "not compared"}
                  <% end %>
                </dd>
                <dt>Dry air</dt>
                <dd>
                  {if g[:virga_risk],
                    do:
                      "depression ≥ 8 °C: light echoes may evaporate before they reach the ground (not applied to the forecast)",
                    else: "no virga risk from the dew point"}
                </dd>
              </dl>
              <p class="zw-eq">
                ratio = (gauge + 0.1) / (radar + 0.1), clamped 0.5 to 2;  weight = min(1, max(gauge, radar) / {g.full_weight_mm} mm)
                factor = 1 + weight × (ratio − 1);  applied only above {g.min_mm} mm in the window; chance is never changed
              </p>
            <% else %>
              <p class="text-sm zw-muted mt-2">No gauge near this point.</p>
            <% end %>
          </details>

          <details open id="lab-verification">
            <summary>Verification: how good is this forecast?</summary>
            <p class="zw-eq">
              Brier score = mean of (chance − outcome)², outcome 1 if the radar shows ≥ 0.1 mm/h at the point, else 0.
              Lower is better. Skill = 1 − Brier / Brier(climatology), where climatology always forecasts the observed
              rain frequency. Persistence says "rain now means rain then".
            </p>
            <%= if @verification && @verification.scored > 0 do %>
              <% v = @verification %>
              <p class="text-sm">
                Live since {v.started_at}: {v.origins} forecast runs at {length(v.points)} places
                ({Enum.join(v.points, ", ")}), {v.scored} outcomes scored, {v.pending} waiting for their radar frame.
              </p>
              <div class="zw-scroll">
                <table class="zw-table" id="lab-live">
                  <thead>
                    <tr>
                      <th>Lead (min)</th>
                      <th>n</th>
                      <th>Rain %</th>
                      <th>Brier chance</th>
                      <th>Brier raw</th>
                      <th>Persistence</th>
                      <th>Climatology</th>
                      <th>Skill</th>
                    </tr>
                  </thead>
                  <tbody>
                    <%= for b <- v.bands, b.n > 0 do %>
                      <tr>
                        <td>{b.lead}</td>
                        <td>{b.n}</td>
                        <td>{b.wet_pct}</td>
                        <td>{b.brier_calibrated}</td>
                        <td>{b.brier_raw}</td>
                        <td>{b.brier_persistence}</td>
                        <td>{b.brier_climatology}</td>
                        <td>
                          {if b.brier_climatology > 0,
                            do: Float.round(1 - b.brier_calibrated / b.brier_climatology, 2),
                            else: "-"}
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
              <%= if Enum.any?(v.bands, & &1[:inca]) do %>
                <p class="text-sm mt-3">
                  Against RMI's own INCA nowcast, on the same outcomes (INCA's chance = share of 3 × 3 cells that
                  rain; "point" = its single-cell yes/no):
                </p>
                <div class="zw-scroll">
                  <table class="zw-table" id="lab-inca">
                    <thead>
                      <tr>
                        <th>Lead (min)</th>
                        <th>n</th>
                        <th>Ours</th>
                        <th>INCA share</th>
                        <th>INCA point</th>
                      </tr>
                    </thead>
                    <tbody>
                      <%= for b <- v.bands, b[:inca] do %>
                        <tr>
                          <td>{b.lead}</td>
                          <td>{b.inca.n}</td>
                          <td>{b.inca.brier_ours_same_rows}</td>
                          <td>{b.inca.brier_inca_share}</td>
                          <td>{b.inca.brier_inca_point}</td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm zw-muted">
                Live scores appear once forecasts made after this server started have been checked against the radar
                (the first ones after about 10 to 15 minutes; the long leads after two hours).
              </p>
            <% end %>
            <p class="text-sm mt-3">
              Replay of one day of RMI radar (13 November 2026, 10 places, 9,354 forecast and outcome pairs, 664 of them wet):
            </p>
            <div class="zw-scroll">
              <table class="zw-table" id="lab-hindcast">
                <thead>
                  <tr>
                    <th>Lead (min)</th>
                    <th>Brier chance</th>
                    <th>Climatology</th>
                    <th>Skill</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>5–20</td><td>0.021</td><td>0.068</td><td>0.69</td>
                  </tr>
                  <tr>
                    <td>45–60</td><td>0.043</td><td>0.068</td><td>0.37</td>
                  </tr>
                  <tr>
                    <td>65–90</td><td>0.055</td><td>0.064</td><td>0.14</td>
                  </tr>
                  <tr>
                    <td>95–125</td><td>0.058</td><td>0.062</td><td>0.06</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="text-xs zw-muted">
              One day of mostly light showers is a small sample. The radar itself is the reference, so this scores
              the extrapolation, not the radar's accuracy.
            </p>
          </details>
        </section>
      <% end %>
    <% end %>

    <section class="zw-section">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="zw-h">Radar</h2>
        <% current_f = current_frame(@frames, @active_frame_index) %>
        <div class="flex items-center gap-3 text-sm">
          <span id="radar-frame-label">{format_frame_time(current_f)}</span>
          <button phx-click="toggle_play" class="zw-btn">
            {if @is_playing, do: "Pause", else: "Play"}
          </button>
        </div>
      </div>

      <% initial_tile = (Enum.at(@frames, @active_frame_index) || %{})[:tile_url_template] %>
      <div
        id="radar-map"
        phx-hook="RadarMap"
        phx-update="ignore"
        data-lat={@active_location.lat}
        data-lon={@active_location.lon}
        data-tile-url={initial_tile}
        class="w-full h-96 sm:h-[460px] relative z-0 border"
        style="border-color: var(--zw-line); background: var(--zw-surface)"
      >
      </div>

      <%= if length(@frames) > 0 do %>
        <div class="pt-2">
          <div class="flex justify-between text-xs zw-muted mb-1">
            <span>Past, -60 min</span>
            <span>Now</span>
            <span>
              {if Enum.any?(@frames, & &1[:forecast_min]), do: "Forecast, +60 min", else: ""}
            </span>
          </div>
          <form id="radar-frame-form" phx-change="set_frame" onsubmit="return false">
            <input
              type="range"
              min="0"
              max={length(@frames) - 1}
              value={@active_frame_index}
              name="index"
            />
          </form>
        </div>
      <% end %>
    </section>

    <section id="sources" class="zw-section">
      <h2 class="zw-h">How this is sourced</h2>
      <dl class="zw-dl" style="grid-template-columns: 11rem 1fr">
        <dt>Rain forecast</dt>
        <dd>
          Computed here from the Belgian radar rain-rate composite of the <a
            href="https://opendata.meteo.be/"
            class="underline"
          >Royal Meteorological Institute (RMI)</a>:
          real floating-point mm/h on a 1.3 km grid every 5 minutes, read from RMI's open-data service
          (no rendered images). When RainViewer's composite is more than 5 minutes newer, that one is used
          instead, because RMI publishes in bursts. RainViewer's rain rates are decoded from its picture palette
          (coarser) and averaged into 0.75 km cells.
        </dd>
        <dt>Drift</dt>
        <dd>
          The shift that best maps the previous frame onto the newest (normalised cross-correlation
          over the rain near the point, two frame pairs combined when they agree). The newest frame
          is then moved along that drift: the rain that will be here in <em>t</em>
          minutes is the rain that is drift × <em>t</em>
          upstream now. Showers neither grow nor decay.
        </dd>
        <dt>Chance</dt>
        <dd>
          The share of a surrounding area (it widens with lead time) that is wet, corrected with a
          calibration table: a raw 100% turned out right about 98% of the time at +10 min but about 55%
          at +55 min. The table comes from about two hours of one afternoon's radar, so treat the
          percentages as rough.
        </dd>
        <dt>Limits</dt>
        <dd>
          The newest radar frame is typically 5 to 10 minutes old and, in a measurement of RMI's feed,
          occasionally much older (it arrives in bursts); the forecast is moved forward from the
          frame's own time, but that age is real. The radar resolves about 1 km, and showers are
          not grown or decayed, so the minute-by-minute timing is an extrapolation. No rain-gauge
          or dew-point correction is applied yet.
        </dd>
        <dt>Cross-check</dt>
        <dd>
          <a href="https://www.buienradar.nl/" class="underline">Buienradar</a>'s 5-minute point forecast
          (interpolated to 1 minute); it is also the fallback while ours is computing.
        </dd>
        <dt>Conditions, air quality</dt>
        <dd>
          <a href="https://open-meteo.com/" class="underline">Open-Meteo</a>
          weather and air quality (Copernicus CAMS).
        </dd>
        <dt>Map</dt>
        <dd>
          Esri gray base map (© Esri, HERE, Garmin, FAO, NOAA, USGS, © OpenStreetMap contributors).
        </dd>
      </dl>
    </section>
  </main>
</div>
